#include <iostream>
#include <string>
#include <fstream>
#include <iomanip>
using namespace std;
struct Student {
    string id;
    string name;
    float score;
};
class StudentManager {
private:
    Student* students;
    int capacity;
    int count;
    void resize() {
        capacity = (capacity == 0) ? 2 : capacity * 2;
        Student* new_students = new Student[capacity];
        for (int i = 0; i < count; i++) {
            new_students[i] = students[i];
        }
        delete[] students;
        students = new_students;
    }
public:
    StudentManager() : students(nullptr), capacity(0), count(0) {}

    ~StudentManager() {
        delete[] students;
    }
    void addStudent() {
        if (count == capacity) resize();
        cout << "Nhap MSSV: "; cin >> students[count].id;
        cin.ignore();
        cout << "Nhap Ten: "; getline(cin, students[count].name);
        cout << "Nhap Diem: "; cin >> students[count].score;
        count++;
        cout << "-> Them thanh cong!\n";
    }
    void deleteStudent() {
        string target_id;
        cout << "Nhap MSSV can xoa: "; cin >> target_id;
        int index = -1;
        for (int i = 0; i < count; i++) {
            if (students[i].id == target_id) {
                index = i; break;
            }
        }
        if (index != -1) {
            for (int i = index; i < count - 1; i++) {
                students[i] = students[i + 1];
            }
            count--;
            cout << "-> Da xoa sinh vien.\n";
        }
        else {
            cout << "-> Khong tim thay MSSV!\n";
        }
    }
    void searchStudent() {
        string query;
        cout << "Nhap ten hoac MSSV can tim: ";
        cin.ignore();
        getline(cin, query);

        bool found = false;
        cout << "--- KET QUA TIM KIEM ---\n";
        for (int i = 0; i < count; i++) {
            if (students[i].id == query || students[i].name == query) {
                cout << "MSSV: " << students[i].id << " | Ten: " << students[i].name << " | Diem: " << students[i].score << "\n";
                found = true;
            }
        }
        if (!found) cout << "Khong tim thay ket qua nao.\n";
    }
    void sortAndDisplay() {
        for (int i = 0; i < count - 1; i++) {
            int max_idx = i;
            for (int j = i + 1; j < count; j++) {
                if (students[j].score > students[max_idx].score) {
                    max_idx = j;
                }
            }
            swap(students[i], students[max_idx]);
        }
        cout << "--- BANG XEP HANG LOP ---\n";
        cout << left << setw(15) << "MSSV" << setw(25) << "Ho va Ten" << "Diem\n";
        for (int i = 0; i < count; i++) {
            cout << left << setw(15) << students[i].id << setw(25) << students[i].name << students[i].score << "\n";
        }
    }
    void exportReport() {
        if (count == 0) {
            cout << "Lop chua co sinh vien!\n";
            return;
        }
        float max_s = students[0].score, min_s = students[0].score, sum = 0;
        for (int i = 0; i < count; i++) {
            if (students[i].score > max_s) max_s = students[i].score;
            if (students[i].score < min_s) min_s = students[i].score;
            sum += students[i].score;
        }
        ofstream file("diem_sinhvien.txt");
        if (!file.is_open()) {
            cout << "Loi mo file!\n";
            return;
        }
        file << "=== BAO CAO QUAN LY DIEM ===\n";
        file << "So luong sinh vien: " << count << "\n";
        file << "Diem cao nhat: " << max_s << "\n";
        file << "Diem thap nhat: " << min_s << "\n";
        file << "Diem trung binh: " << sum / count << "\n";
        file << "----------------------------\n";
        file << left << setw(15) << "MSSV" << setw(25) << "Ho va Ten" << "Diem\n";
        for (int i = 0; i < count; i++) {
            file << left << setw(15) << students[i].id << setw(25) << students[i].name << students[i].score << "\n";
        }
        file.close();
        cout << "-> Da xuat bao cao ra file diem_sinhvien.txt\n";
    }
};
int main() {
    StudentManager manager;
    int choice;
    do {
        cout << "\n=== QUAN LY DIEM SINH VIEN ===\n";
        cout << "1. Them sinh vien\n";
        cout << "2. Xoa sinh vien\n";
        cout << "3. Tim kiem\n";
        cout << "4. Xep hang lop (kem xuat danh sach)\n";
        cout << "5. Xuat bao cao ra file\n";
        cout << "0. Thoat\n";
        cout << "Chon chuc nang: ";
        cin >> choice;
        switch (choice) {
        case 1: manager.addStudent(); break;
        case 2: manager.deleteStudent(); break;
        case 3: manager.searchStudent(); break;
        case 4: manager.sortAndDisplay(); break;
        case 5: manager.exportReport(); break;
        case 0: cout << "Dang thoat...\n"; break;
        default: cout << "Lua chon khong hop le!\n";
        }
    } while (choice != 0);
    return 0;
}

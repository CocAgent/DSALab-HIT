//Bài 1: Linear Search
//Tìm kiếm tuyến tính trên mảng số nguyên và mảng chuỗi.Đếm số bước so sánh.
#include <iostream>
#include <string>
using namespace std;
template <typename T>
int linearSearch(T arr[], int n, T target, int& steps) {
    steps = 0;
    for (int i = 0; i < n; i++) {
        steps++;
        if (arr[i] == target) {
            return i;
        }
    }
    return -1;
}
int main() {
    int intArr[] = { 4, 2, 7, 1, 9, 5 };
    int nInt = sizeof(intArr) / sizeof(intArr[0]);
    int stepsInt = 0;
    cout << "--- Linear Search Mang So Nguyen ---\n";
    int idxInt = linearSearch(intArr, nInt, 9, stepsInt);
    if (idxInt != -1) cout << "Tim thay 9 tai vi tri: " << idxInt << " (So buoc: " << stepsInt << ")\n";
    string strArr[] = { "apple", "banana", "cherry", "date" };
    int nStr = sizeof(strArr) / sizeof(strArr[0]);
    int stepsStr = 0;
    cout << "\n--- Linear Search Mang Chuoi ---\n";
    int idxStr = linearSearch(strArr, nStr, string("cherry"), stepsStr);
    if (idxStr != -1) cout << "Tim thay 'cherry' tai vi tri: " << idxStr << " (So buoc: " << stepsStr << ")\n";
    return 0;
}
//Bài 2: Binary Search
//Cài đặt Binary Search iterative + recursive.Tìm vị trí đầu tiên và cuối cùng của phần tử trùng.
#include <iostream>
using namespace std;
int binarySearchIterative(int arr[], int n, int target) {
    int left = 0, right = n - 1;
    while (left <= right) {
        int mid = left + (right - left) / 2;
        if (arr[mid] == target) return mid;
        if (arr[mid] < target) left = mid + 1;
        else right = mid - 1;
    }
    return -1;
}
int binarySearchRecursive(int arr[], int left, int right, int target) {
    if (left <= right) {
        int mid = left + (right - left) / 2;
        if (arr[mid] == target) return mid;
        if (arr[mid] < target) return binarySearchRecursive(arr, mid + 1, right, target);
        return binarySearchRecursive(arr, left, mid - 1, target);
    }
    return -1;
}
int findFirst(int arr[], int n, int target) {
    int left = 0, right = n - 1, res = -1;
    while (left <= right) {
        int mid = left + (right - left) / 2;
        if (arr[mid] == target) {
            res = mid;
            right = mid - 1;
        }
        else if (arr[mid] < target) left = mid + 1;
        else right = mid - 1;
    }
    return res;
}
int findLast(int arr[], int n, int target) {
    int left = 0, right = n - 1, res = -1;
    while (left <= right) {
        int mid = left + (right - left) / 2;
        if (arr[mid] == target) {
            res = mid;
            left = mid + 1;
        }
        else if (arr[mid] < target) left = mid + 1;
        else right = mid - 1;
    }
    return res;
}

int main() {
    int arr[] = { 1, 2, 2, 2, 2, 3, 4, 7, 8, 8 };
    int n = sizeof(arr) / sizeof(arr[0]);
    int target = 2;

    cout << "Mang: 1 2 2 2 2 3 4 7 8 8\n";
    cout << "Vi tri dau tien cua " << target << ": " << findFirst(arr, n, target) << endl;
    cout << "Vi tri cuoi cung cua " << target << ": " << findLast(arr, n, target) << endl;

    return 0;
}
//Bài 3: So sánh hiệu năng
//Đo thời gian tìm kiếm với n = 10.000, 100.000, 1.000.000 phần tử.Vẽ bảng so sánh.
#include <iostream>
#include <vector>
#include <chrono>
#include <algorithm>
#include <iomanip>
using namespace std;
using namespace std::chrono;
int linearSearchTest(const vector<int>& arr, int target) {
    for (size_t i = 0; i < arr.size(); i++) {
        if (arr[i] == target) return i;
    }
    return -1;
}
int binarySearchTest(const vector<int>& arr, int target) {
    int left = 0, right = arr.size() - 1;
    while (left <= right) {
        int mid = left + (right - left) / 2;
        if (arr[mid] == target) return mid;
        if (arr[mid] < target) left = mid + 1;
        else right = mid - 1;
    }
    return -1;
}
void testPerformance(int n) {
    vector<int> arr(n);
    for (int i = 0; i < n; i++) arr[i] = i;
    int target = n - 1;
    auto start1 = high_resolution_clock::now();
    linearSearchTest(arr, target);
    auto stop1 = high_resolution_clock::now();
    auto duration1 = duration_cast<microseconds>(stop1 - start1);
    auto start2 = high_resolution_clock::now();
    binarySearchTest(arr, target);
    auto stop2 = high_resolution_clock::now();
    auto duration2 = duration_cast<microseconds>(stop2 - start2);

    cout << "| " << setw(9) << n << " | "
        << setw(16) << duration1.count() << " us | "
        << setw(16) << duration2.count() << " us |\n";
}
int main() {
    cout << "--- BANG SO SANH THOI GIAN TIM KIEM ---\n";
    cout << "| So Phan Tu | Linear Search (us) | Binary Search (us) |\n";
    cout << "|------------|--------------------|--------------------|\n";
    testPerformance(10000);
    testPerformance(100000);
    testPerformance(1000000);
    testPerformance(10000000);
    return 0;
}
//Bài 4: Dự Án Mini — Smart Search Engine
#include <iostream>
#include <string>
#include <vector>
#include <chrono>
#include <algorithm>
using namespace std;
using namespace std::chrono;
struct Contact {
    string name;
    string phone;
};
string toLower(string s) {
    string res = s;
    for (char& c : res) c = tolower(c);
    return res;
}
int levenshtein(const string& s1, const string& s2) {
    int m = s1.size(), n = s2.size();
    vector<vector<int>> dp(m + 1, vector<int>(n + 1));

    for (int i = 0; i <= m; i++) dp[i][0] = i;
    for (int j = 0; j <= n; j++) dp[0][j] = j;

    for (int i = 1; i <= m; i++) {
        for (int j = 1; j <= n; j++) {
            if (s1[i - 1] == s2[j - 1])
                dp[i][j] = dp[i - 1][j - 1];
            else
                dp[i][j] = 1 + min({ dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 1] });
        }
    }
    return dp[m][n];
}
class SearchEngine {
private:
    vector<Contact> contacts;
public:
    void addContact(string name, string phone) {
        contacts.push_back({ name, phone });
    }
    void sortByPhone() {
        sort(contacts.begin(), contacts.end(), [](const Contact& a, const Contact& b) {
            return a.phone < b.phone;
            });
    }
    void searchByName(string query) {
        auto start = high_resolution_clock::now();
        int steps = 0;
        vector<Contact> results;
        string queryLower = toLower(query);
        for (const auto& c : contacts) {
            steps++;
            if (toLower(c.name).find(queryLower) != string::npos) {
                results.push_back(c);
            }
        }
        auto stop = high_resolution_clock::now();
        double time_ms = duration<double, milli>(stop - start).count();
        if (!results.empty()) {
            cout << "-> Tim thay " << results.size() << " ket qua:\n";
            for (size_t i = 0; i < results.size(); i++) {
                cout << "   " << i + 1 << ". " << results[i].name << " - " << results[i].phone << "\n";
            }
            cout << "   (Da so sanh " << steps << "/" << contacts.size() << " phan tu - " << time_ms << "ms)\n";
        }
        else {
            cout << "-> Khong tim thay ten chua chuoi '" << query << "'.\n";
            suggestNames(queryLower);
        }
    }

    void searchByPhone(string phoneQuery) {
        sortByPhone();

        auto start = high_resolution_clock::now();
        int left = 0, right = contacts.size() - 1;
        int steps = 0;
        int foundIdx = -1;

        while (left <= right) {
            steps++;
            int mid = left + (right - left) / 2;
            if (contacts[mid].phone == phoneQuery) {
                foundIdx = mid;
                break;
            }
            if (contacts[mid].phone < phoneQuery) left = mid + 1;
            else right = mid - 1;
        }
        auto stop = high_resolution_clock::now();
        double time_ms = duration<double, milli>(stop - start).count();
        if (foundIdx != -1) {
            cout << "-> Tim thay: " << contacts[foundIdx].name << " - " << contacts[foundIdx].phone << "\n";
        }
        else {
            cout << "-> Khong tim thay SDT nay.\n";
        }
        cout << "   (Da so sanh " << steps << " buoc - " << time_ms << "ms)\n";
    }
    void suggestNames(string query) {
        cout << "   Goi y 3 ten gan giong nhat:\n";
        vector<pair<int, Contact>> distances;
        for (const auto& c : contacts) {
            int dist = levenshtein(query, toLower(c.name));
            distances.push_back({ dist, c });
        }
        sort(distances.begin(), distances.end(), [](const pair<int, Contact>& a, const pair<int, Contact>& b) {
            return a.first < b.first;
            });
        for (int i = 0; i < min(3, (int)distances.size()); i++) {
            cout << "   " << i + 1 << ". " << distances[i].second.name << " - " << distances[i].second.phone << "\n";
        }
    }
};
int main() {
    SearchEngine engine;
    engine.addContact("Nguyen Van Minh", "0901234567");
    engine.addContact("Tran Thi Minh Anh", "0912345678");
    engine.addContact("Le Minh Tuan", "0923456789");
    engine.addContact("Hoang Binh", "0934567890");
    engine.addContact("Vu Quoc Manh", "0945678901");
    engine.addContact("Pham Tuan", "0956789012");
    int choice;
    do {
        cout << "\n=== SMART SEARCH ENGINE ===\n";
        cout << "1. Tim kiem theo Ten (Mo)\n";
        cout << "2. Tim kiem theo SDT (Chinh xac)\n";
        cout << "0. Thoat\n";
        cout << "Chon: ";
        cin >> choice;
        if (choice == 1) {
            string q;
            cout << "Nhap ten can tim: ";
            cin.ignore();
            getline(cin, q);
            engine.searchByName(q);
        }
        else if (choice == 2) {
            string p;
            cout << "Nhap SDT can tim: ";
            cin >> p;
            engine.searchByPhone(p);
        }
    } while (choice != 0);
    return 0;
}

void chayBai1() {
    int n, arr[1000];
    std::cout << "\n--- BAI 1: MANG CO BAN ---\nNhap n: "; std::cin >> n;
    if (n <= 0) return;
    std::cout << "Nhap " << n << " phan tu: ";
    for (int i = 0; i < n; i++) std::cin >> arr[i];

    int minV = arr[0], maxV = arr[0]; long long sum = 0;
    for (int i = 0; i < n; i++) {
        if (arr[i] < minV) minV = arr[i];
        if (arr[i] > maxV) maxV = arr[i];
        sum += arr[i];
    }
    std::cout << "Min: " << minV << " | Max: " << maxV << " | Tong: " << sum << " | TB: " << (double)sum / n << '\n';
}

void chayBai2() {
    std::cout << "\n--- BAI 2: MANG 2D ---\n";
    int n, A[30][30], B[30][30], C[30][30] = { 0 };
    std::cout << "Nhap cap n ma tran vuong de nhan: "; std::cin >> n;

    std::cout << "Nhap ma tran A:\n";
    for (int i = 0; i < n; i++) for (int j = 0; j < n; j++) std::cin >> A[i][j];
    std::cout << "Nhap ma tran B:\n";
    for (int i = 0; i < n; i++) for (int j = 0; j < n; j++) std::cin >> B[i][j];

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            for (int k = 0; k < n; k++) C[i][j] += A[i][k] * B[k][j];
        }
    }
    std::cout << "Ma tran ket qua C = A * B:\n";
    for (int i = 0; i < n; i++) {
        std::cout << "[ ";
        for (int j = 0; j < n; j++) std::cout << std::setw(5) << C[i][j] << " ";
        std::cout << "]\n";
    }

    std::cout << "\nTinh dinh thuc ma tran M (3x3):\n";
    int M[3][3];
    for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) std::cin >> M[i][j];
    int det = M[0][0] * M[1][1] * M[2][2] + M[0][1] * M[1][2] * M[2][0] + M[0][2] * M[1][0] * M[2][1]
        - M[0][2] * M[1][1] * M[2][0] - M[0][0] * M[1][2] * M[2][1] - M[0][1] * M[1][0] * M[2][2];
    std::cout << "=> Dinh thuc Det(M) = " << det << '\n';
}

void chayBai3() {
    std::cout << "\n--- BAI 3: CON TRO & CAP PHAT DONG ---\n";
    MyVector v; v.init();
    std::cout << "Push_back cac so: 10, 20, 30\n";
    v.push_back(10); v.push_back(20); v.push_back(30);
    std::cout << "Kich thuoc hien tai: " << v.size << " | Suc chua: " << v.capacity << '\n';
    std::cout << "Cac phan tu: ";
    for (int i = 0; i < v.size; i++) std::cout << v.at(i) << " ";
    std::cout << "\nPop_back 1 phan tu...\n";
    v.pop_back();
    std::cout << "Phan tu cuoi cung sau khi pop: " << v.at(v.size - 1) << '\n';
    v.free();
}

void chayBai4(DanhSachSinhVien& qlsv) {
    int con;
    do {
        std::cout << "\n=== QUAN LY DIEM SINH VIEN ===\n";
        std::cout << "1. Them sinh vien\n2. Xoa sinh vien\n3. Tim kiem\n4. Xep hang lop\n5. Xuat bao cao\n0. Quay lai menu chinh\n";
        std::cout << "Nhap lua chon: "; std::cin >> con; std::cin.ignore();
        switch (con) {
        case 1: {
            SinhVien sv;
            std::cout << "MSSV: "; std::getline(std::cin, sv.mssv);
            std::cout << "Ten: "; std::getline(std::cin, sv.hoTen);
            std::cout << "Diem: "; std::cin >> sv.diem;
            qlsv.themSinhVien(sv); break;
        }
        case 2: {
            std::string mssv; std::cout << "Nhap MSSV can xoa: "; std::getline(std::cin, mssv);
            qlsv.xoaSinhVien(mssv); break; // Hàm xóa sinh viên dựa trên cơ chế dịch mảng
        }
        case 3: {
            std::string tk; std::cout << "Nhap ten/MSSV can tim: "; std::getline(std::cin, tk);
            qlsv.timKiem(tk); break;
        }
        case 4:
            qlsv.sapXepGiamDan();
            std::cout << "\n--- KET QUA XEP HANG TỪ CAO XUỐNG THẤP ---\n";
            qlsv.hienThi(); break;
        case 5:
            qlsv.xuatFile("diem_sinhvien.txt"); break;
        }
    } while (con != 0);
}


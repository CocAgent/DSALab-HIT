// Cấu trúc mảng động tự resize (Bài 3)
struct MyVector {
    int* data;
    int capacity;
    int size;

    void init() {
        capacity = 2; // Bắt đầu nhỏ để dễ quan sát quá trình tự resize
        size = 0;
        data = new int[capacity];
    }

    void resize(int newCapacity) {
        int* temp = new int[newCapacity];
        for (int i = 0; i < size; i++) {
            temp[i] = data[i];
        }
        delete[] data;
        data = temp;
        capacity = newCapacity;
    }

    void push_back(int value) {
        if (size == capacity) {
            resize(capacity * 2);
        }
        data[size] = value;
        size++;
    }

    void pop_back() {
        if (size > 0) size--;
    }

    int at(int index) {
        if (index >= 0 && index < size) return data[index];
        return -1;
    }

    void free() {
        delete[] data;
        data = nullptr;
        size = capacity = 0;
    }
};

// Cấu trúc Quản lý sinh viên (Bài 4)
struct SinhVien {
    std::string mssv;
    std::string hoTen;
    double diem;
};

struct DanhSachSinhVien {
    SinhVien* ds;
    int size;
    int capacity;

    void init() {
        capacity = 4;
        size = 0;
        ds = new SinhVien[capacity];
    }

    void resize(int newCapacity) {
        SinhVien* temp = new SinhVien[newCapacity];
        for (int i = 0; i < size; i++) {
            temp[i] = ds[i];
        }
        delete[] ds;
        ds = temp;
        capacity = newCapacity;
    }

    void themSinhVien(SinhVien sv) {
        if (size == capacity) resize(capacity * 2);
        ds[size] = sv;
        size++;
        std::cout << "-> Them sinh vien thanh cong!\n";
    }

    void xoaSinhVien(std::string mssv) {
        int index = -1;
        for (int i = 0; i < size; i++) {
            if (ds[i].mssv == mssv) {
                index = i;
                break;
            }
        }
        if (index == -1) {
            std::cout << "-> Khong tim thay MSSV: " << mssv << '\n';
            return;
        }
        for (int i = index; i < size - 1; i++) {
            ds[i] = ds[i + 1];
        }
        size--;
        std::cout << "-> Xoa sinh vien thanh cong!\n";
    }

    void timKiem(std::string tuKhoa) {
        bool timThay = false;
        std::cout << "\n" << std::left << std::setw(15) << "MSSV" << std::setw(25) << "Ho va Ten" << std::setw(10) << "Diem" << '\n';
        for (int i = 0; i < size; i++) {
            if (ds[i].mssv == tuKhoa || ds[i].hoTen.find(tuKhoa) != std::string::npos) {
                std::cout << std::left << std::setw(15) << ds[i].mssv << std::setw(25) << ds[i].hoTen << std::setw(10) << ds[i].diem << '\n';
                timThay = true;
            }
        }
        if (!timThay) std::cout << "Khong tim thay sinh vien phu hop.\n";
    }

    void sapXepGiamDan() {
        for (int i = 0; i < size - 1; i++) {
            int maxIdx = i;
            for (int j = i + 1; j < size; j++) {
                if (ds[j].diem > ds[maxIdx].diem) maxIdx = j;
            }
            SinhVien temp = ds[i];
            ds[i] = ds[maxIdx];
            ds[maxIdx] = temp;
        }
    }

    void hienThi() {
        if (size == 0) { std::cout << "Danh sach trong!\n"; return; }
        std::cout << std::left << std::setw(6) << "STT" << std::setw(15) << "MSSV" << std::setw(25) << "Ho va Ten" << std::setw(10) << "Diem" << '\n';
        for (int i = 0; i < size; i++) {
            std::cout << std::left << std::setw(6) << i + 1 << std::setw(15) << ds[i].mssv << std::setw(25) << ds[i].hoTen << std::setw(10) << ds[i].diem << '\n';
        }
    }

    void xuatFile(std::string filename) {
        std::ofstream fout(filename);
        if (!fout.is_open()) return;
        fout << "=== BAO CAO DIEM SINH VIEN ===\n\n";
        double maxDiem = size > 0 ? ds[0].diem : 0, minDiem = size > 0 ? ds[0].diem : 0, tong = 0;
        for (int i = 0; i < size; i++) {
            fout << std::left << std::setw(15) << ds[i].mssv << std::setw(25) << ds[i].hoTen << std::setw(10) << ds[i].diem << '\n';
            if (ds[i].diem > maxDiem) maxDiem = ds[i].diem;
            if (ds[i].diem < minDiem) minDiem = ds[i].diem;
            tong += ds[i].diem;
        }
        if (size > 0) {
            fout << "\nMax: " << maxDiem << " | Min: " << minDiem << " | Avg: " << (tong / size) << '\n';
        }
        fout.close();
        std::cout << "-> Da xuat file '" << filename << "'\n";
    }

    void free() {
        delete[] ds;
        ds = nullptr;
        size = capacity = 0;
    }
};


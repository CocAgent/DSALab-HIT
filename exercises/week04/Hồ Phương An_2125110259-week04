// Struct lưu cấu trúc thống kê cho Bài 2 và Bài 3
struct SortStats {
    long long comparisons = 0;
    long long swaps = 0;
    double duration_ms = 0.0;
};

// --- CÁC HÀM BỔ TRỢ ---
void printArray(const vector<int>& arr) {
    for (int x : arr) cout << x << " ";
    cout << "\n";
}

vector<int> generateRandomArray(int size) {
    vector<int> arr(size);
    for (int i = 0; i < size; ++i) arr[i] = rand() % 100 + 1; // 1 đến 100
    return arr;
}

vector<int> generateSortedArray(int size) {
    vector<int> arr(size);
    for (int i = 0; i < size; ++i) arr[i] = i + 1;
    return arr;
}

vector<int> generateReversedArray(int size) {
    vector<int> arr(size);
    for (int i = 0; i < size; ++i) arr[i] = size - i;
    return arr;
}


// ==========================================
// BÀI 1: CÀI ĐẶT 3 THUẬT TOÁN & IN TỪNG BƯỚC
// ==========================================
void bubbleSortDemo(vector<int> arr) {
    cout << "\n--- BUBBLE SORT DEMO ---\nBan dau: "; printArray(arr);
    int n = arr.size();
    int step = 1;
    for (int i = 0; i < n - 1; ++i) {
        bool swapped = false;
        for (int j = 0; j < n - i - 1; ++j) {
            if (arr[j] > arr[j + 1]) {
                swap(arr[j], arr[j + 1]);
                swapped = true;
                cout << "Buoc " << step++ << " (Swap " << arr[j + 1] << " & " << arr[j] << "): ";
                printArray(arr);
            }
        }
        if (!swapped) break;
    }
}

void selectionSortDemo(vector<int> arr) {
    cout << "\n--- SELECTION SORT DEMO ---\nBan dau: "; printArray(arr);
    int n = arr.size();
    int step = 1;
    for (int i = 0; i < n - 1; ++i) {
        int min_idx = i;
        for (int j = i + 1; j < n; ++j) {
            if (arr[j] < arr[min_idx]) min_idx = j;
        }
        if (min_idx != i) {
            swap(arr[i], arr[min_idx]);
            cout << "Buoc " << step++ << " (Swap " << arr[min_idx] << " & " << arr[i] << "): ";
            printArray(arr);
        }
    }
}

void insertionSortDemo(vector<int> arr) {
    cout << "\n--- INSERTION SORT DEMO ---\nBan dau: "; printArray(arr);
    int n = arr.size();
    int step = 1;
    for (int i = 1; i < n; ++i) {
        int key = arr[i];
        int j = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
        cout << "Buoc " << step++ << " (Chen " << key << "): ";
        printArray(arr);
    }
}


// ==========================================
// BÀI 2 & 3: ĐẾM PHÉP TÍNH & ĐO THỜI GIAN
// ==========================================
SortStats bubbleSortCalc(vector<int> arr) {
    SortStats stats;
    int n = arr.size();
    auto start = chrono::high_resolution_clock::now();

    for (int i = 0; i < n - 1; ++i) {
        bool swapped = false;
        for (int j = 0; j < n - i - 1; ++j) {
            stats.comparisons++;
            if (arr[j] > arr[j + 1]) {
                swap(arr[j], arr[j + 1]);
                stats.swaps++;
                swapped = true;
            }
        }
        if (!swapped) break;
    }

    auto end = chrono::high_resolution_clock::now();
    stats.duration_ms = chrono::duration<double, milli>(end - start).count();
    return stats;
}

SortStats selectionSortCalc(vector<int> arr) {
    SortStats stats;
    int n = arr.size();
    auto start = chrono::high_resolution_clock::now();

    for (int i = 0; i < n - 1; ++i) {
        int min_idx = i;
        for (int j = i + 1; j < n; ++j) {
            stats.comparisons++;
            if (arr[j] < arr[min_idx]) {
                min_idx = j;
            }
        }
        if (min_idx != i) {
            swap(arr[i], arr[min_idx]);
            stats.swaps++;
        }
    }

    auto end = chrono::high_resolution_clock::now();
    stats.duration_ms = chrono::duration<double, milli>(end - start).count();
    return stats;
}

SortStats insertionSortCalc(vector<int> arr) {
    SortStats stats;
    int n = arr.size();
    auto start = chrono::high_resolution_clock::now();

    for (int i = 1; i < n; ++i) {
        int key = arr[i];
        int j = i - 1;
        // Phép so sánh đầu tiên của vòng lặp while (hoặc kiểm tra điều kiện)
        while (j >= 0) {
            stats.comparisons++;
            if (arr[j] > key) {
                arr[j + 1] = arr[j];
                stats.swaps++; // Coi hành động dịch chuyển như 1 lần ghi nhận đổi chỗ/hoán vị dữ liệu
                j--;
            }
            else {
                break;
            }
        }
        arr[j + 1] = key;
    }

    auto end = chrono::high_resolution_clock::now();
    stats.duration_ms = chrono::duration<double, milli>(end - start).count();
    return stats;
}

void runExercise2And3() {
    cout << "\n======================================================\n";
    cout << "BÀI 2 & BÀI 3: THỐNG KÊ CHI TIẾT (Mảng 100 phần tử)\n";

// ANSI Color Codes
#define RESET   "\033[0m"
#define RED     "\033[31m"
#define GREEN   "\033[32m"
#define YELLOW  "\033[33m"
#define CYAN    "\033[36m"

void clearConsole() {
#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif
}

// Vẽ đồ họa ASCII bar
void renderVisualizer(const vector<int>& arr, int active1, int active2, string algoName, int currentStep, int totalSteps) {
    clearConsole();
    cout << CYAN << "=== SORTING VISUALIZER (CONSOLE) ===" << RESET << "\n";
    cout << YELLOW << algoName << " — Bước " << currentStep << "/" << totalSteps << ":" << RESET << "\n\n";

    for (int i = 0; i < (int)arr.size(); ++i) {
        // Nếu phần tử đang được so sánh thì tô màu RED/YELLOW, ngược lại màu GREEN mặc định
        if (i == active1 || i == active2) {
            cout << RED;
        }
        else {
            cout << GREEN;
        }

        // Vẽ các thanh chữ nhật ký tự ASCII '█' tỉ lệ thuận với giá trị phần tử
        for (int k = 0; k < arr[i]; ++k) {
            cout << "█";
        }
        // In giá trị số ở cuối thanh
        cout << " " << arr[i] << RESET << "\n";
    }

    cout << "\nĐang so sánh: vị trí [" << active1 << "] và [" << active2 << "] " << RED << "← đánh dấu màu" << RESET << "\n";
    cout << "Số bước còn lại: " << (totalSteps - currentStep) << "\n";
    this_thread::sleep_for(chrono::milliseconds(200)); // Delay 200ms theo yêu cầu
}

void runVisualizer() {
    // Mảng dữ liệu mẫu trực quan (tầm 10-15 phần tử để dễ nhìn trên console)
    vector<int> origin = { 17, 12, 22, 8, 15, 5, 25, 19, 10, 14 };

    while (true) {
        cout << "\n======================================================\n";
        cout << "BÀI 4: CHỌN THUẬT TOÁN ĐỂ XEM VISUALIZER\n";
        cout << "1. Bubble Sort\n";
        cout << "2. Selection Sort\n";
        cout << "3. Insertion Sort\n";
        cout << "4. Thoát Visualizer\n";
        cout << "Lựa chọn của bạn (1-4): ";
        int choice;
        cin >> choice;

        if (choice == 4) break;

        vector<int> arr = origin;
        int n = arr.size();

        if (choice == 1) {
            // Đếm tổng ước lượng bước trước để hiển thị Step X/Y
            int totalSteps = 0;
            vector<int> temp = arr;
            for (int i = 0; i < n - 1; ++i) {
                for (int j = 0; j < n - i - 1; ++j) totalSteps++;
            }

            int currStep = 0;
            for (int i = 0; i < n - 1; ++i) {
                for (int j = 0; j < n - i - 1; ++j) {
                    currStep++;
                    renderVisualizer(arr, j, j + 1, "Bubble Sort", currStep, totalSteps);
                    if (arr[j] > arr[j + 1]) {
                        swap(arr[j], arr[j + 1]);
                    }
                }
            }
            // Render bước cuối đã hoàn thành sạch đẹp
            renderVisualizer(arr, -1, -1, "Bubble Sort (Hoàn thành!)", totalSteps, totalSteps);

        }
        else if (choice == 2) {
            int totalSteps = 0;
            for (int i = 0; i < n - 1; ++i) {
                for (int j = i + 1; j < n; ++j) totalSteps++;
            }

            int currStep = 0;
            for (int i = 0; i < n - 1; ++i) {
                int min_idx = i;
                for (int j = i + 1; j < n; ++j) {
                    currStep++;
                    renderVisualizer(arr, min_idx, j, "Selection Sort", currStep, totalSteps);
                    if (arr[j] < arr[min_idx]) {
                        min_idx = j;
                    }
                }
                if (min_idx != i) {
                    swap(arr[i], min_idx);
                }
            }
            renderVisualizer(arr, -1, -1, "Selection Sort (Hoàn thành!)", totalSteps, totalSteps);

        }
        else if (choice == 3) {
            // Mô phỏng số bước ước tính dựa trên thuật toán chèn thực tế
            int currStep = 0;
            int totalSteps = 25; // Ước chừng đại lượng cho mảng ngẫu nhiên 10 phần tử này để thanh tiến trình mượt mà

            for (int i = 1; i < n; ++i) {
                int key = arr[i];
                int j = i - 1;
                while (j >= 0) {
                    currStep++;
                    renderVisualizer(arr, j, j + 1, "Insertion Sort", min(currStep, totalSteps), totalSteps);
                    if (arr[j] > key) {
                        arr[j + 1] = arr[j];
                        j--;
                    }
                    else {
                        break;
                    }
                }
                arr[j + 1] = key;
            }
            renderVisualizer(arr, -1, -1, "Insertion Sort (Hoàn thành!)", totalSteps, totalSteps);
        }
        else {
            cout << "Lựa chọn không hợp lệ.\n";
        }
    }
}



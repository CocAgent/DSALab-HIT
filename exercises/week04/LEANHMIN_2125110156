Đang so sánh: vị trí [1] và [2] ← đánh dấu màu
Số bước còn lại: 5
Yêu cầu: dùng ANSI color codes để tô màu thanh đang so sánh, delay 200ms giữa các bước, cho phép chọn thuật toán.
#include <iostream>
#include <thread>
#include <chrono>
#include <cstdlib>

using namespace std;

// ===== ANSI COLOR =====
#define RED     "\033[31m"
#define GREEN   "\033[32m"
#define YELLOW  "\033[33m"
#define RESET   "\033[0m"

void sleep200()
{
    this_thread::sleep_for(
        chrono::milliseconds(200)
    );
}

void clearScreen()
{
#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif
}

// ================= DRAW =================
void draw(int a[], int n, int x, int y, int step, int total)
{
    clearScreen();

    cout << GREEN << "===== SORTING VISUALIZER =====\n" << RESET;
    cout << "Step: " << step << "/" << total << "\n\n";

    for(int i=0;i<n;i++)
    {
        if(i==x || i==y)
            cout << RED;
        else
            cout << YELLOW;

        for(int j=0;j<a[i];j++)
            cout << "█";

        cout << " " << a[i] << RESET << endl;
    }

    cout << "\nDang so sanh: [" << x << "] va [" << y << "]\n";
    cout << "So buoc con lai: " << (total-step) << endl;

    sleep200();
}

// ================= BUBBLE =================
void bubble(int a[], int n)
{
    int total = n*(n-1)/2;
    int step = 0;

    for(int i=0;i<n-1;i++)
    {
        for(int j=0;j<n-i-1;j++)
        {
            step++;

            draw(a,n,j,j+1,step,total);

            if(a[j] > a[j+1])
                swap(a[j],a[j+1]);
        }
    }
}

// ================= SELECTION =================
void selection(int a[], int n)
{
    int total = n*(n-1)/2;
    int step = 0;

    for(int i=0;i<n-1;i++)
    {
        int min=i;

        for(int j=i+1;j<n;j++)
        {
            step++;

            draw(a,n,min,j,step,total);

            if(a[j] < a[min])
                min=j;
        }

        swap(a[i],a[min]);
    }
}

// ================= INSERTION =================
void insertion(int a[], int n)
{
    int total = n*(n-1)/2;
    int step = 0;

    for(int i=1;i<n;i++)
    {
        int key=a[i];
        int j=i-1;

        while(j>=0 && a[j]>key)
        {
            step++;

            draw(a,n,j,j+1,step,total);

            a[j+1]=a[j];
            j--;
        }

        a[j+1]=key;
    }
}

// ================= MAIN =================
int main()
{
    int a[] = {17,12,22,8,15,10,5,20};
    int n = sizeof(a)/sizeof(a[0]);

    cout << "===== SORTING VISUALIZER =====\n";
    cout << "1. Bubble Sort\n";
    cout << "2. Selection Sort\n";
    cout << "3. Insertion Sort\n";

    int choice;
    cout << "Chon: ";
    cin >> choice;

    int b[100];
    for(int i=0;i<n;i++) b[i]=a[i];

    switch(choice)
    {
        case 1:
            bubble(b,n);
            break;
        case 2:
            selection(b,n);
            break;
        case 3:
            insertion(b,n);
            break;
        default:
            cout << "Sai lua chon!";
    }

    cout << "\nDone!\n";
    return 0;
}

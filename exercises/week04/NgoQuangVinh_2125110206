// BÀI 4: 🔥 DỰ ÁN MINI — SORTING VISUALIZER (CONSOLE) - ĐÃ FIX SẠCH LỖI
// ============================================================================
void renderVisual(const vector<int>& arr, int active1 = -1, int active2 = -1, string info = "") {
    cout << "\033[H";//QTN: Thay vì xóa màn hình làm giật/lỗi hình, lệnh này đưa con trỏ lên góc trên cùng bên trái để vẽ đè liên tục các thanh kí tự
    cout << CYAN << "=== SORTING VISUALIZER (CONSOLE) ===" << RESET << "\n\n";
    cout << info << "\n\n";

    for (int i = 0; i < arr.size(); ++i) {
        if (i == active1 || i == active2) cout << RED;
        else cout << RESET;

        for (int j = 0; j < arr[i]; ++j) cout << "█";
        cout << " " << arr[i] << "\033[K" << endl;
    }
    this_thread::sleep_for(chrono::milliseconds(200));
}
//Ưu điểm: Biến các thuật toán khô khan thành giao diện đồ họa trực quan, có màu sắc, cực kỳ dễ học và bắt mắt.
//Nhược điểm : Chỉ trực quan được với mảng kích thước nhỏ(khoảng 15 - 20 phần tử), mảng quá lớn sẽ bị tràn màn hình Console.

void bubbleVisual(vector<int>& arr) {
    int n = arr.size();
    for (int i = 0; i < n - 1; ++i) {
        for (int j = 0; j < n - i - 1; ++j) {
            string info = "Bubble Sort -> Dang so sanh: vi tri [" + intToString(j) + "] va [" + intToString(j + 1) + "]";
            renderVisual(arr, j, j + 1, info);
            if (arr[j] > arr[j + 1]) {
                swap(arr[j], arr[j + 1]);
                renderVisual(arr, j, j + 1, info + " -> Hoan vi!");
            }
        }
    }
}

void selectionVisual(vector<int>& arr) {
    int n = arr.size();
    for (int i = 0; i < n - 1; ++i) {
        int min_idx = i;
        for (int j = i + 1; j < n; ++j) {
            renderVisual(arr, j, min_idx, "Selection Sort -> Tim Min. So sanh [" + intToString(j) + "] voi Min hien tai [" + intToString(min_idx) + "]");
            if (arr[j] < arr[min_idx]) {
                min_idx = j;
            }
        }
        if (min_idx != i) {
            swap(arr[i], arr[min_idx]);
            renderVisual(arr, i, min_idx, "Selection Sort -> Doi cho phan tu nho nhat ve vi tri thich hop [" + intToString(i) + "]");
        }
    }
}

void insertionVisual(vector<int>& arr) {
    int n = arr.size();
    for (int i = 1; i < n; ++i) {
        int key = arr[i];
        int j = i - 1;

        string info_start = "Insertion Sort -> Chon Key = " + intToString(key) + " o vi tri [" + intToString(i) + "]";
        renderVisual(arr, i, -1, info_start);

        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            renderVisual(arr, j, j + 1, "Insertion Sort -> Di chuyen " + intToString(arr[j]) + " len vi tri [" + intToString(j + 1) + "]");
            j--;
        }
        arr[j + 1] = key;
        renderVisual(arr, j + 1, -1, "Insertion Sort -> Chen Key (" + intToString(key) + ") vao vi tri trong [" + intToString(j + 1) + "]");
    }
}


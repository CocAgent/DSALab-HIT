// BÀI 2: ĐẾM SỐ PHÉP SO SÁNH VÀ SỐ LẦN HOÁN VỊ (MẢNG 100 PHẦN TỬ)
// ============================================================================
SortStats bubbleSortCount(vector<int> arr) {
    SortStats stats;
    int n = arr.size();
    for (int i = 0; i < n - 1; ++i) {
        bool swapped = false;
        for (int j = 0; j < n - i - 1; ++j) {
            stats.comparisons++;//QTN
            if (arr[j] > arr[j + 1]) {
                swap(arr[j], arr[j + 1]);
                stats.swaps++;//QTN: Cung cấp số liệu chính xác để chứng minh lý thuyết (ví dụ: Selection Sort hoán vị ít hơn Bubble Sort).
                swapped = true;
            }
        }
        if (!swapped) break;
    }
    return stats;
}
//Ưu điểm: Giúp người học hiểu sâu bản chất bên trong của mã nguồn hoạt động nặng hay nhẹ.
//Nhược điểm : Làm code bị dài và rối hơn do phải chèn biến đếm vào khắp nơi.
SortStats selectionSortCount(vector<int> arr) {
    SortStats stats;
    int n = arr.size();
    for (int i = 0; i < n - 1; ++i) {
        int min_idx = i;
        for (int j = i + 1; j < n; ++j) {
            stats.comparisons++;
            if (arr[j] < arr[min_idx]) min_idx = j;
        }
        if (min_idx != i) {
            swap(arr[i], arr[min_idx]);
            stats.swaps++;
        }
    }
    return stats;
}

SortStats insertionSortCount(vector<int> arr) {
    SortStats stats;
    int n = arr.size();
    for (int i = 1; i < n; ++i) {
        int key = arr[i];
        int j = i - 1;
        while (j >= 0) {
            stats.comparisons++;
            if (arr[j] > key) {
                arr[j + 1] = arr[j];
                stats.swaps++;
                j--;
            }
            else {
                break;
            }
        }
        arr[j + 1] = key;
    }
    return stats;
}


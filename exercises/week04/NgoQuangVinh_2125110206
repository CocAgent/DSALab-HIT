void bubbleSortDebug(vector<int> arr) {
    int n = arr.size();
    cout << "\n--- Bubble Sort (Tung buoc) ---" << endl;
    printArray(arr);
    for (int i = 0; i < n - 1; ++i) {
        bool swapped = false;
        for (int j = 0; j < n - i - 1; ++j) {
            if (arr[j] > arr[j + 1]) {
                swap(arr[j], arr[j + 1]);
                swapped = true;
                printArray(arr);//QTN: Dòng code này bắt máy tính phải "báo cáo" lại trạng thái của mảng ngay lập tức sau khi có một sự thay đổi vị trí. Nó giúp bạn nhìn thấy dòng chảy của dữ liệu: số lớn trôi về sau thế nào, số nhỏ được chọn đưa lên đầu ra sao.
            }
        }
        if (!swapped) break;
    }
}

void selectionSortDebug(vector<int> arr) {
    int n = arr.size();
    cout << "\n--- Selection Sort (Tung buoc) ---" << endl;
    printArray(arr);
    for (int i = 0; i < n - 1; ++i) {
        int min_idx = i;
        for (int j = i + 1; j < n; ++j) {
            if (arr[j] < arr[min_idx]) min_idx = j;
        }
        if (min_idx != i) {
            swap(arr[i], arr[min_idx]);
            printArray(arr);
        }
    }
}

void insertionSortDebug(vector<int> arr) {
    int n = arr.size();
    cout << "\n--- Insertion Sort (Tung buoc) ---" << endl;
    printArray(arr);
    for (int i = 1; i < n; ++i) {
        int key = arr[i];
        int j = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
        printArray(arr);
    }
}



// BÀI 3: ĐO THỜI GIAN CHẠY TRÊN CÁC TRƯỜNG HỢP (BEST / WORST / AVERAGE)
// ============================================================================
void bubbleSortPure(vector<int>& arr) {
    int n = arr.size();
    for (int i = 0; i < n - 1; ++i) {
        bool swapped = false;
        for (int j = 0; j < n - i - 1; ++j) {
            if (arr[j] > arr[j + 1]) {
                swap(arr[j], arr[j + 1]);
                swapped = true;
            }
        }
        if (!swapped) break;
    }
}

void selectionSortPure(vector<int>& arr) {
    int n = arr.size();
    for (int i = 0; i < n - 1; ++i) {
        int min_idx = i;
        for (int j = i + 1; j < n; ++j)
            if (arr[j] < arr[min_idx]) min_idx = j;
        if (min_idx != i) swap(arr[i], arr[min_idx]);
    }
}

void insertionSortPure(vector<int>& arr) {
    int n = arr.size();
    for (int i = 1; i < n; ++i) {
        int key = arr[i];
        int j = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }
}

double measureTime(void (*sortFunc)(vector<int>&), vector<int> arr) {
    auto start = high_resolution_clock::now();//QTN: Đo đạc tốc độ thực tế của máy tính phản hồi khi xử lý lượng dữ liệu lớn (3000 phần tử).
    sortFunc(arr);
    auto stop = high_resolution_clock::now();
    duration<double, milli> time_span = stop - start;
    return time_span.count();
}
//Ưu điểm: Đưa ra cái nhìn thực tế (tính bằng mili-giây ms) để lập trình viên biết khi nào nên chọn giải thuật nào cho dự án.
//Nhược điểm : Kết quả phụ thuộc vào độ mạnh / yếu của CPU máy tính tại thời điểm chạy.


void chayBai3() {
    int N = 3000;
    vector<int> best(N), worst(N), avg(N);
    for (int i = 0; i < N; ++i) {
        best[i] = i;
        worst[i] = N - i; 
        avg[i] = rand() % 10000;
    }

    cout << "\n=== ĐO THOI GIAN CHAY THUC TE (MANG " << N << " PHAN TU) ===\n\n";
    cout << "| Thuat toan     | Best Case (Sorted) | Worst Case (Reverse) | Average Case (Random) |\n";
    cout << "|----------------|--------------------|----------------------|-----------------------|\n";

    cout << "| Bubble Sort    | " << setw(15) << measureTime(bubbleSortPure, best) << " ms | "
        << setw(17) << measureTime(bubbleSortPure, worst) << " ms | "
        << setw(18) << measureTime(bubbleSortPure, avg) << " ms |\n";

    cout << "| Selection Sort | " << setw(15) << measureTime(selectionSortPure, best) << " ms | "
        << setw(17) << measureTime(selectionSortPure, worst) << " ms | "
        << setw(18) << measureTime(selectionSortPure, avg) << " ms |\n";

    cout << "| Insertion Sort | " << setw(15) << measureTime(insertionSortPure, best) << " ms | "
        << setw(17) << measureTime(insertionSortPure, worst) << " ms | "
        << setw(18) << measureTime(insertionSortPure, avg) << " ms |\n\n";

    cout << "💡 KET LUAN SU DUNG:\n";
    cout << " - Insertion Sort: Toi uu nhat khi mang da hoac gan nhu da sap xep san.\n";
    cout << " - Selection Sort: Thich hop neu bo du lieu nang/cong kenh vi so lan hoan vi luon on dinh và toi thieu.\n";
    cout << " - Bubble Sort: Hieu nang kem nhat, chi toi uu khi mang da sap xep xong som (nhan dien qua co swapped).\n";
}

void printArray(const vector<int>& arr) {
    for (int val : arr) cout << val << " ";
    cout << "\n";
}

vector<int> generateArray(int size, string type) {
    vector<int> arr(size);
    if (type == "sorted") {
        for (int i = 0; i < size; i++) arr[i] = i + 1;
    }
    else if (type == "reversed") {
        for (int i = 0; i < size; i++) arr[i] = size - i;
    }
    else {
        random_device rd;
        mt19937 gen(rd());
        uniform_int_distribution<> dis(3, 20);
        for (int i = 0; i < size; i++) arr[i] = dis(gen);
    }
    return arr;
}

void drawVisualizer(const vector<int>& arr, int idx1, int idx2, string algoName, int currentStep) {
#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif

    cout << "=========================================\n";
    cout << " " << algoName << " - Buoc: " << currentStep << "\n";
    cout << "=========================================\n\n";

    for (int i = 0; i < arr.size(); i++) {
        string colorCode = "\033[0m";
        if (i == idx1 || i == idx2) {
            colorCode = "\033[1;31m"; // Màu đỏ nổi bật khi so sánh
        }

        cout << " ";
        cout << colorCode;

        for (int k = 0; k < arr[i]; k++) {
            cout << "[]";
        }

        cout << "\033[0m" << " " << arr[i] << "\n";
    }

    cout << "\n Dang so sanh vi tri: [" << idx1 << "] va [" << idx2 << "]\n";
    this_thread::sleep_for(chrono::milliseconds(200));
}

void runBenchmarking() {
    int size = 100;
    vector<string> cases = { "sorted", "reversed", "random" };

    cout << "\n=== BIEU DO DANH GIA HIEU NANG (Mang " << size << " phan tu) ===\n\n";

    for (const string& cCase : cases) {
        vector<int> original = generateArray(size, cCase);

        auto start = chrono::high_resolution_clock::now();
        SortStats bStats = bubbleSort(original);
        auto end = chrono::high_resolution_clock::now();
        bStats.duration_ms = chrono::duration<double, milli>(end - start).count();

        start = chrono::high_resolution_clock::now();
        SortStats sStats = selectionSort(original);
        end = chrono::high_resolution_clock::now();
        sStats.duration_ms = chrono::duration<double, milli>(end - start).count();

        start = chrono::high_resolution_clock::now();
        SortStats iStats = insertionSort(original);
        end = chrono::high_resolution_clock::now();
        iStats.duration_ms = chrono::duration<double, milli>(end - start).count();

        cout << ">> TRUONG HOP MANG: " << cCase << "\n";
        cout << "-----------------------------------------------------------------\n";
        cout << left << setw(18) << "Thuat toan" << setw(15) << "So sanh" << setw(15) << "Hoan vi/Dich" << setw(15) << "Thoi gian (ms)" << "\n";
        cout << "-----------------------------------------------------------------\n";
        cout << left << setw(18) << "Bubble Sort" << setw(15) << bStats.comparisons << setw(15) << bStats.swaps << setw(15) << fixed << setprecision(4) << bStats.duration_ms << "\n";
        cout << left << setw(18) << "Selection Sort" << setw(15) << sStats.comparisons << setw(15) << sStats.swaps << setw(15) << fixed << setprecision(4) << sStats.duration_ms << "\n";
        cout << left << setw(18) << "Insertion Sort" << setw(15) << iStats.comparisons << setw(15) << iStats.swaps << setw(15) << fixed << setprecision(4) << iStats.duration_ms << "\n";
        cout << "-----------------------------------------------------------------\n\n";
    }
}


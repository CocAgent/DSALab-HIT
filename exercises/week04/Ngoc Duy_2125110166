SortStats bubbleSort(vector<int> arr, bool printSteps = false) {
    SortStats stats;
    int n = arr.size();
    int stepCount = 0;

    for (int i = 0; i < n - 1; i++) {
        bool swapped = false;
        for (int j = 0; j < n - i - 1; j++) {
            stats.comparisons++;
            if (arr[j] > arr[j + 1]) {
                swap(arr[j], arr[j + 1]);
                stats.swaps++;
                swapped = true;

                if (printSteps) {
                    cout << "Step " << ++stepCount << ": Swap (" << arr[j + 1] << ", " << arr[j] << ") -> ";
                    printArray(arr);
                }
            }
        }
        if (!swapped) break;
    }
    return stats;
}
//Bubble Sort: Duyệt mảng nhiều lần, đẩy phần tử lớn nhất về cuối. Thêm swapped để tối ưu: nếu một lượt duyệt mà không có hoán vị nào xảy ra, tức là mảng đã xếp xong, chương trình sẽ tự ngắt sớm.
//Tệ nhất trong 3 thuật toán do phải hoán vị quá nhiều lần liên tục. Ít dùng thực tế ngoài mục đích giảng dạy.

SortStats selectionSort(vector<int> arr, bool printSteps = false) {
    SortStats stats;
    int n = arr.size();
    int stepCount = 0;

    for (int i = 0; i < n - 1; i++) {
        int min_idx = i;
        for (int j = i + 1; j < n; j++) {
            stats.comparisons++;
            if (arr[j] < arr[min_idx]) {
                min_idx = j;
            }
        }
        if (min_idx != i) {
            swap(arr[i], arr[min_idx]);
            stats.swaps++;

            if (printSteps) {
                cout << "Step " << ++stepCount << ": Swap index " << i << " and " << min_idx << " -> ";
                printArray(arr);
            }
        }
        else if (printSteps) {
            cout << "Step " << ++stepCount << ": Index " << i << " dung vi tri -> ";
            printArray(arr);
        }
    }
    return stats;
}
//Selection Sort: Tìm phần tử nhỏ nhất trong đoạn chưa xếp và đưa nó về vị trí đầu. Số lần so sánh luôn là n(n-1)/2, nhưng số lần hoán vị lại cực ít
//Số lần So sánh luôn cố định nhưng số lần Hoán vị cực kỳ ít (tối đa $n$ lần).

SortStats insertionSort(vector<int> arr, bool printSteps = false) {
    SortStats stats;
    int n = arr.size();
    int stepCount = 0;

    for (int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;

        stats.comparisons++;
        while (j >= 0 && arr[j] > key) {
            if (j < i - 1) stats.comparisons++;
            arr[j + 1] = arr[j];
            stats.swaps++;
            j--;
        }
        arr[j + 1] = key;

        if (printSteps) {
            cout << "Step " << ++stepCount << ": Insert " << key << " -> ";
            printArray(arr);
        }
    }
    return stats;
}
//Insertion Sort: Giống như cách bạn xếp bài trên tay. Nó lấy từng phần tử và chèn vào vị trí thích hợp trong đoạn đã xếp. Đây là thuật toán nhanh nhất trong 3 cái khi dữ liệu "gần như đã sắp xếp".
//Hiệu năng thực tế tốt nhất trong 3 thuật toán dạng sơ cấp nhờ cơ chế chèn lùi linh hoạt.

// ==========================================
// BÀI 4: VISUALIZER (Đã sửa lỗi Selection Visualizer)
// ==========================================
void runVisualizer(vector<int> arr, int choice) {
    int n = arr.size();
    string algoName = (choice == 1) ? "Bubble Sort" : (choice == 2) ? "Selection Sort" : "Insertion Sort";
    int currentStep = 0;

    if (choice == 1) {
        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                currentStep++;
                drawVisualizer(arr, j, j + 1, algoName, currentStep);
                if (arr[j] > arr[j + 1]) {
                    swap(arr[j], arr[j + 1]);
                }
            }
        }
        drawVisualizer(arr, -1, -1, algoName, currentStep);
    }
    else if (choice == 2) { // Selection Sort Visualizer
        for (int i = 0; i < n - 1; i++) {
            int min_idx = i;
            for (int j = i + 1; j < n; j++) {
                currentStep++;
                // Hiển thị phần tử nhỏ nhất hiện tại (min_idx) và phần tử đang duyệt (j)
                drawVisualizer(arr, min_idx, j, algoName, currentStep);
                if (arr[j] < arr[min_idx]) {
                    min_idx = j;
                }
            }
            // SỬA LỖI: Đồng bộ logic swap đúng vào đồ họa trực quan
            swap(arr[i], arr[min_idx]);
        }
        drawVisualizer(arr, -1, -1, algoName, currentStep);
    }
    else if (choice == 3) {
        for (int i = 1; i < n; i++) {
            int key = arr[i];
            int j = i - 1;
            while (j >= 0 && arr[j] > key) {
                currentStep++;
                arr[j + 1] = arr[j];
                drawVisualizer(arr, j, j + 1, algoName, currentStep);
                j--;
            }
            arr[j + 1] = key;
        }
        drawVisualizer(arr, -1, -1, algoName, currentStep);
    }
}


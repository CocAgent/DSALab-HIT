    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < a[i]; j++)
            cout << (char)219;

        cout << " " << a[i] << endl;
    }

    Sleep(200);
}

void BubbleSortVisual(int a[], int n)
{
    for (int i = 0; i < n - 1; i++)
    {
        for (int j = 0; j < n - i - 1; j++)
        {
            if (a[j] > a[j + 1])
                swap(a[j], a[j + 1]);

            VeMang(a, n);
        }
    }
}


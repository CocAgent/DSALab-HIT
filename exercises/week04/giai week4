#include "Header.h"
int main() {
    const int n = 100;
    int src[n];
    int arr[n];
    SortStats bubbleStats;
    SortStats selectionStats;
    SortStats insertionStats;

    srand((unsigned)time(NULL));
    for (int i = 0; i < 100; i++)
    {
        src[i] = rand() % 1000;
    }


    // bubble
    copy(src, src + n, arr);
    cout << "bubble sort\n";
    cout << "  ban dau: "; printArray(arr, n);
    bubbleSort(arr, n, bubbleStats);
    cout << "  ket qua: "; printArray(arr, n);

    // selection
    copy(src, src + n, arr);
    cout << "\nselection sort\n";
    cout << "  ban dau: "; printArray(arr, n);
    selectionSort(arr, n, selectionStats);
    cout << "  ket qua: "; printArray(arr, n);

    // insertion
    copy(src, src + n, arr);
    cout << "\ninsertion sort\n";
    cout << "  ban dau: "; printArray(arr, n);
    insertionSort(arr, n, insertionStats);
    cout << "  ket qua: "; printArray(arr, n);
    cout << "algo   \tso sanh  \tSwaps\n";

    cout << "Bubble\t\t"
        << bubbleStats.ss << "\t\t"
        << bubbleStats.swaps << endl;

    cout << "Selection\t"
        << selectionStats.ss << "\t\t"
        << selectionStats.swaps << endl;

    cout << "Insertion\t"
        << insertionStats.ss << "\t\t"
        << insertionStats.swaps << endl;


    return 0;
}

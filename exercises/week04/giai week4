#include "Header.h"
//4-1
void printArray(int arr[], int n) {
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";
    cout << "\n";
}
void bubbleSort(int arr[], int n)
{
    for (int i = 0; i < n -1; i++)
    {
        bool swapped = false;
        for (int j = 0; j < n - 1 - i;j++)
        {
            if (arr[j] > arr[j + 1])
            {
                std::swap(arr[j],arr[j + 1]);
                swapped = true;
            }
        }
        if (!swapped) break;
    }
}
void selectionSort(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int minIdx = i;
        for (int j = i + 1; j < n; j++)
            if (arr[j] < arr[minIdx]) minIdx = j;
        if (minIdx != i) {
            swap(arr[i], arr[minIdx]);
            cout << "  swap [" << i << "] <> [" << minIdx << "]: ";
            printArray(arr, n);
        }
    }
}
void insertionSort(int arr[], int n) {
    for (int i = 1; i < n; i++) {
        int key = arr[i], j = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
        cout << "  insert key=" << key << " at [" << j + 1 << "]: ";
        printArray(arr, n);
    }
}


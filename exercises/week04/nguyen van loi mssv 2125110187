Sort(a, n);

auto end = chrono::high_resolution_clock::now();

return chrono::duration_cast chrono::microseconds (end - start).count(); } Tạo dữ liệu //Best Case for(int i=0;i<n;i++) a[i]=i; //Worst Case for(int i=0;i<n;i++) a[i]=n-i; //Average Case for(int i=0;i<n;i++) a[i]=rand()%1000;


// BAI 2: QUICK SORT - 3 CHIEN LUOC CHON PIVOT
// ============================================================

struct QStats {
    long long comparisons = 0;
    long long swaps = 0;
};

// --- Pivot: Dau mang ---
int partitionFirst(vector<int>& arr, int low, int high, QStats& s) {
    int pivot = arr[low]; // Chọn phần tử đầu tiên làm mốc
    int i = low + 1;
    for (int j = low + 1; j <= high; j++) {
        s.comparisons++;
        // >>> DÒNG QUAN TRỌNG: Phân loại phần tử nhỏ hơn pivot về bên trái <<<
        if (arr[j] < pivot) {
            swap(arr[i], arr[j]);
            s.swaps++;
            i++;
        }
    }
    swap(arr[low], arr[i - 1]); // Đưa pivot về đúng vị trí biên giữa 2 phe
    s.swaps++;
    return i - 1;
}
void quickSortFirst(vector<int>& arr, int low, int high, QStats& s) {
    if (low < high) {
        int pi = partitionFirst(arr, low, high, s);
        quickSortFirst(arr, low, pi - 1, s);  // Đệ quy phân rã nhánh trái
        quickSortFirst(arr, pi + 1, high, s); // Đệ quy phân rã nhánh phải
    }
}

// --- Pivot: Cuoi mang ---
int partitionLast(vector<int>& arr, int low, int high, QStats& s) {
    int pivot = arr[high]; // Chọn phần tử cuối cùng làm mốc
    int i = low - 1;
    for (int j = low; j < high; j++) {
        s.comparisons++;
        if (arr[j] <= pivot) {
            i++;
            swap(arr[i], arr[j]);
            s.swaps++;
        }
    }
    swap(arr[i + 1], arr[high]); // Trả pivot về giữa
    s.swaps++;
    return i + 1;
}
void quickSortLast(vector<int>& arr, int low, int high, QStats& s) {
    if (low < high) {
        int pi = partitionLast(arr, low, high, s);
        quickSortLast(arr, low, pi - 1, s);
        quickSortLast(arr, pi + 1, high, s);
    }
}

// --- Pivot: Giua mang ---
int partitionMiddle(vector<int>& arr, int low, int high, QStats& s) {
    int mid = low + (high - low) / 2; // Tìm vị trí chính giữa mảng
    swap(arr[mid], arr[high]);        // Mẹo hoán đổi: Giấu pivot về cuối mảng để dùng lại logic chuẩn
    int pivot = arr[high];
    int i = low - 1;
    for (int j = low; j < high; j++) {
        s.comparisons++;
        if (arr[j] <= pivot) {
            i++;
            swap(arr[i], arr[j]);
            s.swaps++;
        }
    }
    swap(arr[i + 1], arr[high]); // Đưa pivot từ chỗ giấu về lại vị trí phân chia chuẩn
    s.swaps++;
    return i + 1;
}
void quickSortMiddle(vector<int>& arr, int low, int high, QStats& s) {
    if (low < high) {
        int pi = partitionMiddle(arr, low, high, s);
        quickSortMiddle(arr, low, pi - 1, s);
        quickSortMiddle(arr, pi + 1, high, s);
    }
}

// --- Pivot: Ngau nhien ---
int partitionRandom(vector<int>& arr, int low, int high, QStats& s) {
    // Chọn đại một vị trí ngẫu nhiên bất kỳ trong đoạn từ low đến high
    int randIdx = low + rand() % (high - low + 1);
    swap(arr[randIdx], arr[high]); // Đẩy phần tử ngẫu nhiên đó về cuối mảng
    int pivot = arr[high];
    int i = low - 1;
    for (int j = low; j < high; j++) {
        s.comparisons++;
        if (arr[j] <= pivot) {
            i++;
            swap(arr[i], arr[j]);
            s.swaps++;
        }
    }
    swap(arr[i + 1], arr[high]);
    s.swaps++;
    return i + 1;
}
void quickSortRandom(vector<int>& arr, int low, int high, QStats& s) {
    if (low < high) {
        int pi = partitionRandom(arr, low, high, s);
        quickSortRandom(arr, low, pi - 1, s);
        quickSortRandom(arr, pi + 1, high, s);
    }
}

void bai2_quicksort() {
    const int N = 1000;
    srand(42);

    vector<int> base(N);
    for (int i = 0; i < N; i++) base[i] = rand() % 10000;

